# ============================================================
# ResearchTrics — Environment Configuration (EXAMPLE)
# Copy to .env and fill in. NEVER commit real secrets (Spec §35, §95).
# ============================================================

# ---- Core ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Local dev: a single Postgres, both URLs identical.
DATABASE_URL=postgresql://researchtrics:researchtrics@localhost:5432/researchtrics?schema=public
# Direct (non-pooled) connection for migrations, if using a pooler in prod.
DIRECT_URL=postgresql://researchtrics:researchtrics@localhost:5432/researchtrics?schema=public
#
# Neon (serverless): use the POOLED host for DATABASE_URL and the DIRECT host
# for DIRECT_URL. Example shape:
#   DATABASE_URL=postgresql://USER:PW@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true
#   DIRECT_URL=postgresql://USER:PW@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
# The app uses the pooled URL; `prisma migrate` uses DIRECT_URL automatically.

# ---- Redis (cache + BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Security ----
# 32+ char random string. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# 32-byte key (base64) for encrypting OAuth tokens at rest. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me-base64-32-bytes-key

# ---- Object storage (S3-compatible: Cloudflare R2 / AWS S3 / MinIO) ----
# Leave these UNSET to use the local-filesystem provider in development.
# When all four required vars (ENDPOINT, BUCKET, KEY, SECRET) are set, the app
# uses the S3 provider automatically (selected at boot via instrumentation).
#
# Cloudflare R2 example:
#   OBJECT_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   OBJECT_STORAGE_REGION=auto
#   OBJECT_STORAGE_FORCE_PATH_STYLE=true
#   OBJECT_STORAGE_KEY / _SECRET = an R2 API token's Access Key ID / Secret
#   OBJECT_STORAGE_PUBLIC_URL = an R2 custom domain or r2.dev URL (public files)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=researchtrics
OBJECT_STORAGE_KEY=minioadmin
OBJECT_STORAGE_SECRET=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Optional: public base URL for directly-served objects (else served via app).
OBJECT_STORAGE_PUBLIC_URL=

# ---- Integrations (Phase 2+; not required for Phase 1) ----
# ORCID
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/api/v1/integrations/orcid/callback
ORCID_ENVIRONMENT=sandbox
# Crossref (polite pool contact)
CROSSREF_MAILTO=
# OpenAlex (polite pool contact)
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# OJS (fresh install provisioned in docker-compose)
OJS_BASE_URL=http://localhost:8081
OJS_SITE_ID=
OJS_API_KEY=

# ---- AI provider (Phase 11; abstraction default = Claude) ----
AI_PROVIDER=claude
AI_API_KEY=

# ---- Email (Phase 2+) ----
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@researchtrics.local
