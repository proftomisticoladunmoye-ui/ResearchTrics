// ResearchTrics — Prisma schema
// Phase 1 (Foundation) scope. Aligned with docs/DATABASE-ARCHITECTURE.md.
// Later phases add: publications, projects, datasets, instruments, software,
// journals, metrics, rvm_*, ojs_*, sync_*, notifications, etc.
//
// Conventions:
// - Primary keys: uuid (v4 default; v7 preferred once pinned to a Prisma version
//   that supports uuid(7) across the toolchain).
// - Provenance on imported records via ExternalRecord (Spec §84).
// - Soft deletion via deletedAt on scholarly-adjacent records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserStatus {
  active
  suspended
  pending
}

enum RoleType {
  researcher
  student_researcher
  research_assistant
  research_group_admin
  institution_admin
  department_admin
  journal_editor
  publisher_admin
  reviewer
  research_administrator
  funder
  employer
  platform_admin
  super_admin
}

enum ScopeType {
  global
  institution
  department
  research_group
  journal
}

enum ResearcherType {
  academic
  independent
  student
  research_assistant
  practitioner
  other
}

enum CareerStage {
  undergraduate
  graduate
  doctoral
  early_career
  mid_career
  senior
  professor
  research_administrator
  independent
}

enum VisibilityLevel {
  public
  researchers
  institution
  private
}

enum IdentifierScheme {
  orcid
  scopus
  wos
  openalex
  scholar_url
  ror
}

enum ExternalSource {
  crossref
  orcid
  openalex
  ojs
  datacite
  pubmed
  ror
  user
}

enum AffiliationRole {
  faculty
  postdoc
  phd_student
  masters_student
  research_staff
  visiting
  emeritus
  other
}

/// Research output types (Spec §9) — not limited to journal articles.
enum OutputType {
  journal_article
  conference_paper
  conference_proceeding
  preprint
  postprint
  working_paper
  technical_report
  research_report
  thesis
  dissertation
  book
  book_chapter
  dataset
  instrument
  software
  poster
  presentation
  policy_brief
  research_brief
  systematic_review
  meta_analysis
  registered_report
  other
}

/// Version-of-record lineage (Spec §60).
enum PublicationVersion {
  preprint
  accepted_manuscript
  version_of_record
  correction
  retraction
}

/// Identifier schemes for publications.
enum PublicationIdScheme {
  doi
  pmid
  pmcid
  arxiv
  isbn
  openalex
  handle
}

/// Citation counts are source-labelled and never merged (Spec §33).
enum CitationSource {
  crossref
  openalex
  scholar
  scopus
  wos
}

/// File access levels (Spec §46, §34).
enum FileAccessLevel {
  public
  restricted
  request
  embargoed
  private
}

/// Background sync lifecycle (Spec §12, §73).
enum SyncStatus {
  pending
  running
  completed
  failed
  partial
}

enum SyncKind {
  manual
  scheduled
  webhook
}

/// How an OJS source is harvested (Spec §12). Detected at runtime, never assumed.
enum OjsStrategy {
  oai_pmh
  native_rest
}

/// Collaboration request lifecycle (Spec §18).
enum CollaborationRequestStatus {
  pending
  accepted
  declined
  withdrawn
}

/// Project lifecycle (Spec §19).
enum ProjectStatus {
  proposed
  active
  completed
  suspended
  archived
}

/// Dataset access conditions (Spec §20). Restricted content is never exposed.
enum DatasetAccessLevel {
  open
  restricted
  request
  embargoed
  private
}

/// Analytics event types (Spec §41). Distinguishes the interaction kinds the
/// platform counts; bots are flagged and excluded from human counts.
enum AnalyticsEventType {
  page_view
  publication_view
  profile_view
  project_view
  dataset_view
  instrument_view
  software_view
  journal_view
  institution_view
  download
  citation_export
  search_appearance
  follow
  external_referral
}

/// Kinds of research opportunity that can be curated (Phase 13, Spec §20).
enum OpportunityType {
  grant
  fellowship
  call_for_papers
  conference
  position
  award
  training
  collaboration
  other
}

enum OpportunityStatus {
  draft
  open
  closed
  archived
}

/// Lifecycle of a researcher profile through discovery and claiming
/// (Discovery Engine §3, §68). Discovered ≠ verified until the researcher
/// proves ownership.
enum ProfileStatus {
  discovered
  match_review
  unclaimed
  claim_pending
  claimed
  verified
  disputed
  merged
  suppressed
}

/// How a claim opportunity reached the researcher (Discovery Engine §17).
enum ClaimChannel {
  public
  institutional
  referral
  ambassador
  email_optin
  researcher_initiated
}

enum ClaimInvitationStatus {
  pending
  sent
  viewed
  claimed
  declined
  expired
  revoked
}

/// A researcher's decision about a candidate publication (Discovery Engine §14, §15).
enum PublicationClaimStatus {
  claimed
  disputed
  review
}

/// Subscription tier (§premium). Core visibility is always free; premium unlocks
/// depth (more AI, web browsing, deep analytics, reports).
enum PlanTier {
  free
  premium
}

// ============================================================
// Identity & accounts
// ============================================================

/// Auth principal only — NOT the scholarly identity (Spec §7).
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(pending)
  emailVerified Boolean   @default(false) @map("email_verified")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  mfaSecret    String?    @map("mfa_secret")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions           Session[]
  roles              UserRole[]
  opportunitiesPosted Opportunity[] @relation("OpportunityPoster")
  claimReferrals      ClaimInvitation[] @relation("ClaimReferrer")
  researcher         Researcher?
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]
  blogPosts          BlogPost[]
  researchBulletins  ResearchBulletin[] @relation("BulletinAuthor")

  @@index([status])
  @@map("users")
}

/// Server-side sessions with rotation support (Spec §35).
model Session {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  rotatedFrom String?  @map("rotated_from")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// RBAC role assignment, scoped to a context (Spec §6, §49).
model UserRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  role      RoleType
  scopeType ScopeType @default(global) @map("scope_type")
  scopeId   String?   @map("scope_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@index([userId])
  @@map("user_roles")
}

/// Core scholarly identity — persistent RTX ID (Spec §7).
model Researcher {
  id              String  @id @default(uuid())
  researchtricsId String  @unique @map("researchtrics_id") // RTX-00000001
  userId          String? @unique @map("user_id")

  givenNames    String?  @map("given_names")
  familyName    String?  @map("family_name")
  preferredName String?  @map("preferred_name")
  displayName   String   @map("display_name")
  slug          String   @unique
  biography     String?
  country       String?
  city          String?
  academicRank  String?  @map("academic_rank")
  website       String?
  photoUrl      String?  @map("photo_url")

  researcherType     ResearcherType  @default(academic) @map("researcher_type")
  careerStage        CareerStage?    @map("career_stage")
  verificationLevel  Int             @default(0) @map("verification_level")
  profileVisibility  VisibilityLevel @default(public) @map("profile_visibility")

  // Discovery & claiming (Discovery Engine §3, §26). identityConfidence is a
  // DISTINCT construct from RVM — it measures how sure we are of *who this is*,
  // never research visibility.
  profileStatus      ProfileStatus @default(claimed) @map("profile_status")
  identityConfidence Int?          @map("identity_confidence") // 0..100
  discoverySource    String?       @map("discovery_source")

  // Cached grounded AI overview (§29, §48), precomputed in the background so
  // profile pages never call an LLM on request. Labelled AI-generated in the UI;
  // never asserted as verified fact.
  aiSummary      String?   @map("ai_summary")
  aiSummaryModel String?   @map("ai_summary_model")
  aiSummaryAt    DateTime? @map("ai_summary_at")

  // Subscription (§premium). planUntil null = no expiry (or free).
  plan      PlanTier  @default(free)
  planUntil DateTime? @map("plan_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  identifiers         ResearcherIdentifier[]
  nameVariants        ResearcherNameVariant[]
  affiliations        Affiliation[]
  interests           ResearchInterest[]
  verificationRecords VerificationRecord[]
  orcidConnection     OrcidConnection?
  authorships         PublicationAuthor[]
  projectsLed         Project[]           @relation("ProjectPI")
  projectMemberships  ProjectMember[]
  datasetsCreated     Dataset[]
  instrumentsAuthored Instrument[]
  softwareAuthored    Software[]
  groupsLed           ResearchGroup[]     @relation("GroupLead")
  groupMemberships    ResearchGroupMember[]
  sentCollabRequests     CollaborationRequest[] @relation("CollabFrom")
  receivedCollabRequests CollaborationRequest[] @relation("CollabTo")
  opportunitySaves       OpportunitySave[]
  discoverySources       ResearcherSource[]
  claimInvitations       ClaimInvitation[]
  publicationClaims      ResearcherPublicationClaim[]
  notifications          Notification[]               @relation("ResearcherNotifications")
  following              Follow[]                     @relation("Following")
  followers              Follow[]                     @relation("Followers")
  publicationSaves       PublicationSave[]
  orcidWorkSyncs         OrcidWorkSync[]

  @@index([familyName])
  @@index([profileStatus])
  @@index([verificationLevel])
  @@map("researchers")
}

/// External scholarly identifiers as mappings — internal RTX stays authoritative (Spec §7, §85).
model ResearcherIdentifier {
  id           String           @id @default(uuid())
  researcherId String           @map("researcher_id")
  scheme       IdentifierScheme
  value        String
  verified     Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([scheme, value])
  @@index([researcherId])
  @@map("researcher_identifiers")
}

/// Name variants for disambiguation — never auto-merge on name alone (Spec §7, §58).
model ResearcherNameVariant {
  id           String  @id @default(uuid())
  researcherId String  @map("researcher_id")
  name         String
  script       String?
  source       String?

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@index([researcherId])
  @@map("researcher_name_variants")
}

// ============================================================
// Organizations
// ============================================================

model Institution {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  rorId     String? @unique @map("ror_id")
  country   String?
  city      String?
  type      String?
  isTenant  Boolean @default(false) @map("is_tenant")

  // ROR institution normalization (Federation §8): alternate names/acronyms
  // that resolve to this canonical institution, plus its homepage.
  aliases   String[] @default([])
  website   String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  departments    Department[]
  affiliations   Affiliation[]
  projects       Project[]
  datasets       Dataset[]
  researchGroups ResearchGroup[]
  opportunities  Opportunity[]

  @@index([country])
  @@map("institutions")
}

model Department {
  id                 String  @id @default(uuid())
  institutionId      String  @map("institution_id")
  name               String
  parentDepartmentId String? @map("parent_department_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  children         Department[] @relation("DepartmentHierarchy")
  affiliations     Affiliation[]

  @@index([institutionId])
  @@map("departments")
}

/// Time-bounded M:N — verified affiliations never overwritten blindly (Spec §85).
model Affiliation {
  id            String          @id @default(uuid())
  researcherId  String          @map("researcher_id")
  institutionId String          @map("institution_id")
  departmentId  String?         @map("department_id")
  role          AffiliationRole @default(faculty)
  startDate     DateTime?       @map("start_date")
  endDate       DateTime?       @map("end_date")
  isPrimary     Boolean         @default(false) @map("is_primary")
  verified      Boolean         @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  researcher  Researcher  @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([researcherId])
  @@index([institutionId])
  @@map("affiliations")
}

// ============================================================
// Identity: interests, verification, ORCID (Phase 2 — Spec §7, §13, §38)
// ============================================================

/// Free-text research interests (Spec §7, §8).
model ResearchInterest {
  id           String   @id @default(uuid())
  researcherId String   @map("researcher_id")
  label        String
  createdAt    DateTime @default(now()) @map("created_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([researcherId, label])
  @@index([researcherId])
  @@map("research_interests")
}

/// Auditable verification history (Spec §38). Levels 0..5; honestly labelled.
model VerificationRecord {
  id           String   @id @default(uuid())
  researcherId String   @map("researcher_id")
  level        Int
  method       String
  evidenceRef  String?  @map("evidence_ref")
  verifiedById String?  @map("verified_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@index([researcherId])
  @@map("verification_records")
}

/// ORCID OAuth connection. Tokens are ENCRYPTED at rest and never exposed to
/// the frontend (Spec §13, §35).
model OrcidConnection {
  id                String    @id @default(uuid())
  researcherId      String    @unique @map("researcher_id")
  orcid             String    @unique
  accessTokenEnc    String    @map("access_token_enc")
  refreshTokenEnc   String?   @map("refresh_token_enc")
  scope             String?
  tokenExpiresAt    DateTime? @map("token_expires_at")
  connectedAt       DateTime  @default(now()) @map("connected_at")
  lastSyncedAt      DateTime? @map("last_synced_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@map("orcid_connections")
}

/// Tracks works pushed into a researcher's ORCID record (Spec §13). The
/// `putCode` is ORCID's id for the created work, kept so we never push the same
/// work twice and can update/delete it later.
model OrcidWorkSync {
  id            String   @id @default(uuid())
  researcherId  String   @map("researcher_id")
  publicationId String   @map("publication_id")
  putCode       String   @map("put_code")
  syncedAt      DateTime @default(now()) @map("synced_at")

  researcher  Researcher  @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([researcherId, publicationId])
  @@index([publicationId])
  @@map("orcid_work_syncs")
}

/// ResearchTrics Research Bulletin — a scholarly knowledge-publishing series
/// (NOT the ordinary blog). Each bulletin is a distinct, publicly-readable,
/// citable publication with a permanent number/URL and full scholarly metadata.
/// Authors and references are held as structured JSON in Phase 1; the internal
/// citation graph and normalized author tables arrive in later phases. DOI/ISSN
/// fields are present-but-empty so registration can be added without a rebuild.
enum BulletinStatus {
  draft
  in_review
  scheduled
  published
  archived
}

enum BulletinType {
  research
  methodological
  psychometric
  statistical
  ai_research
  research_technology
  conceptual
  evidence
  research_practice
  policy_research
  replication
  commentary
  data_analysis
}

model ResearchBulletin {
  id              String         @id @default(uuid())
  /// Permanent series number, assigned at first publish (drafts have none).
  number          Int?           @unique
  slug            String         @unique
  title           String
  subtitle        String?
  type            BulletinType   @default(research)
  category        String
  status          BulletinStatus @default(draft)
  abstract        String
  keywords        String[]
  /// Sanitized semantic HTML (allow-listed on save).
  bodyHtml        String         @map("body_html")
  /// [{ name, affiliation?, orcid?, order }] — ordered author list.
  authors         Json           @default("[]")
  /// [{ raw, doi?, url?, type? }] — the reference list.
  references      Json           @default("[]")
  featuredImage   String?        @map("featured_image")
  /// all_rights_reserved | cc_by | cc_by_nc | cc_by_nc_sa
  license         String         @default("all_rights_reserved")
  version         Int            @default(1)
  publicationDate DateTime?      @map("publication_date")
  scheduledFor    DateTime?      @map("scheduled_for")

  // DOI-ready (never displayed unless actually registered)
  doi             String?
  doiStatus       String?        @map("doi_status")
  doiRegisteredAt DateTime?      @map("doi_registered_at")

  viewCount       Int            @default(0) @map("view_count")
  downloadCount   Int            @default(0) @map("download_count")

  authorUserId    String?        @map("author_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  authorUser User? @relation("BulletinAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  citesOut   BulletinCitation[] @relation("Citing")
  citedBy    BulletinCitation[] @relation("Cited")
  collections BulletinCollectionMember[]
  comments    BulletinComment[]

  @@index([status, publicationDate])
  @@index([type])
  @@index([category])
  @@map("research_bulletins")
}

/// A directed internal citation edge: `citing` bulletin references `cited`
/// bulletin. Derived from links in the body on publish; powers "Cited by" and
/// the research knowledge graph (§15, §16, §30).
model BulletinCitation {
  id        String   @id @default(uuid())
  citingId  String   @map("citing_id")
  citedId   String   @map("cited_id")
  createdAt DateTime @default(now()) @map("created_at")

  citing ResearchBulletin @relation("Citing", fields: [citingId], references: [id], onDelete: Cascade)
  cited  ResearchBulletin @relation("Cited", fields: [citedId], references: [id], onDelete: Cascade)

  @@unique([citingId, citedId])
  @@index([citedId])
  @@map("bulletin_citations")
}

enum BulletinCollectionKind {
  collection
  series
}

enum BulletinCommentStatus {
  pending
  approved
  rejected
}

/// Moderated scholarly discussion on a bulletin (§35). Nothing is shown publicly
/// until an admin approves it. Email is collected for moderation/contact and is
/// NEVER exposed publicly.
model BulletinComment {
  id                String                @id @default(uuid())
  bulletinId        String                @map("bulletin_id")
  authorName        String                @map("author_name")
  authorEmail       String                @map("author_email")
  authorAffiliation String?               @map("author_affiliation")
  authorOrcid       String?               @map("author_orcid")
  body              String
  status            BulletinCommentStatus @default(pending)
  createdAt         DateTime              @default(now()) @map("created_at")
  approvedAt        DateTime?             @map("approved_at")

  bulletin ResearchBulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  @@index([bulletinId, status])
  @@index([status])
  @@map("bulletin_comments")
}

/// A curated grouping of Research Bulletins — a thematic `collection` (unordered)
/// or an ordered `series` (a research curriculum). Public knowledge pathways
/// (§53, §54).
model BulletinCollection {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  title       String
  description String?
  kind        BulletinCollectionKind @default(collection)
  published   Boolean                @default(true)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  members BulletinCollectionMember[]

  @@index([published])
  @@map("bulletin_collections")
}

/// Membership of a bulletin in a collection, with an order index for series.
model BulletinCollectionMember {
  id           String @id @default(uuid())
  collectionId String @map("collection_id")
  bulletinId   String @map("bulletin_id")
  order        Int    @default(0)

  collection BulletinCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bulletin   ResearchBulletin   @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  @@unique([collectionId, bulletinId])
  @@index([bulletinId])
  @@map("bulletin_collection_members")
}

/// Single-use tokens for email verification / password reset (Spec §38, §40).
/// Only the hash of the token is stored.
model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  purpose   String
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ============================================================
// Publications & outputs (Phase 3 — Spec §9, §10, §33, §60)
// ============================================================

model Journal {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  issnPrint      String? @map("issn_print")
  issnElectronic String? @map("issn_electronic")
  publisher      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  publications Publication[]

  @@index([name])
  @@map("journals")
}

/// A scholarly publication — a first-class graph node, never an isolated PDF (Spec §1, §10).
model Publication {
  id          String             @id @default(uuid())
  publicId    String             @unique @map("public_id") // RTP-00000001
  slug        String             @unique
  title       String
  abstract    String?
  outputType  OutputType         @default(journal_article) @map("output_type")
  versionType PublicationVersion @default(version_of_record) @map("version_type")

  journalId   String?  @map("journal_id")
  volume      String?
  issue       String?
  firstPage   String?  @map("first_page")
  lastPage    String?  @map("last_page")
  publishedOn DateTime? @map("published_on")
  publishedYear Int?    @map("published_year")
  publisher   String?
  articleType String?  @map("article_type")

  licenseCode String?  @map("license_code")
  openAccess  Boolean  @default(false) @map("open_access")
  pdfUrl      String?  @map("pdf_url")
  primaryFileId String? @unique @map("primary_file_id")

  visibility VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  journal        Journal?                  @relation(fields: [journalId], references: [id], onDelete: SetNull)
  primaryFile    File?                     @relation("PrimaryFile", fields: [primaryFileId], references: [id], onDelete: SetNull)
  identifiers    PublicationIdentifier[]
  authors        PublicationAuthor[]
  citationCounts PublicationCitationCount[]
  projectLinks   ProjectPublication[]
  researcherClaims ResearcherPublicationClaim[]
  unifiedRecord    UnifiedWorkRecord?
  notifications    Notification[]
  savedBy          PublicationSave[]
  orcidWorkSyncs   OrcidWorkSync[]

  @@index([publishedYear])
  @@index([journalId])
  @@map("publications")
}

model PublicationIdentifier {
  id            String              @id @default(uuid())
  publicationId String              @map("publication_id")
  scheme        PublicationIdScheme
  value         String
  createdAt     DateTime            @default(now()) @map("created_at")

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([scheme, value])
  @@index([publicationId])
  @@map("publication_identifiers")
}

/// Ordered authorship. Researcher link is nullable + confidence-scored; every
/// author renders even when unmatched (Spec §58).
model PublicationAuthor {
  id              String  @id @default(uuid())
  publicationId   String  @map("publication_id")
  researcherId    String? @map("researcher_id")
  authorOrder     Int     @map("author_order")
  rawName         String  @map("raw_name")
  givenName       String? @map("given_name")
  familyName      String? @map("family_name")
  affiliationText String? @map("affiliation_text")
  orcid           String?
  isCorresponding Boolean @default(false) @map("is_corresponding")
  matchConfidence Float?  @map("match_confidence")

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  researcher  Researcher? @relation(fields: [researcherId], references: [id], onDelete: SetNull)

  @@unique([publicationId, authorOrder])
  @@index([publicationId])
  @@index([researcherId])
  @@map("publication_authors")
}

/// Source-labelled citation counts — never merged across providers (Spec §33).
model PublicationCitationCount {
  id            String         @id @default(uuid())
  publicationId String         @map("publication_id")
  source        CitationSource
  count         Int            @default(0)
  asOf          DateTime       @default(now()) @map("as_of")

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, source])
  @@index([publicationId])
  @@map("publication_citation_counts")
}

/// Object-storage file reference — never store blobs in Postgres (Spec §46).
model File {
  id            String          @id @default(uuid())
  storageKey    String          @unique @map("storage_key")
  filename      String
  mimeType      String          @map("mime_type")
  sizeBytes     Int             @map("size_bytes")
  checksumSha256 String         @map("checksum_sha256")
  accessLevel   FileAccessLevel @default(public) @map("access_level")
  licenseCode   String?         @map("license_code")
  pdfHasText    Boolean?        @map("pdf_has_text")
  uploaderId    String?         @map("uploader_id")

  createdAt DateTime @default(now()) @map("created_at")

  primaryForPublication Publication? @relation("PrimaryFile")

  @@index([uploaderId])
  @@map("files")
}

// ============================================================
// Projects, grants & research outputs (Phase 6 — Spec §19–22)
// ============================================================

model Funder {
  id        String  @id @default(uuid())
  name      String
  rorId     String? @map("ror_id")
  country   String?
  funderDoi String? @map("funder_doi")

  createdAt DateTime @default(now()) @map("created_at")

  grants   Grant[]
  projects Project[]
  opportunities Opportunity[]

  @@map("funders")
}

model Grant {
  id        String    @id @default(uuid())
  title     String
  funderId  String?   @map("funder_id")
  amount    Decimal?  @db.Decimal(14, 2)
  currency  String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")

  funder   Funder?   @relation(fields: [funderId], references: [id], onDelete: SetNull)
  projects Project[]

  @@index([funderId])
  @@map("grants")
}

/// A forward-looking research opportunity researchers can discover — grants,
/// fellowships, calls, positions (Phase 13, Spec §20). Every listing carries
/// provenance (`source`, `sourceUrl`, `postedBy`); nothing is fabricated.
model Opportunity {
  id            String            @id @default(uuid())
  publicId      String            @unique @map("public_id") // RTO-00000001
  slug          String            @unique
  title         String
  type          OpportunityType   @default(grant)
  status        OpportunityStatus @default(open)
  summary       String?
  description   String?
  organization  String? // posting body, free text
  country       String?
  url           String? // canonical external link to apply / read more
  amountMin     Decimal?          @db.Decimal(14, 2) @map("amount_min")
  amountMax     Decimal?          @db.Decimal(14, 2) @map("amount_max")
  currency      String?
  opensAt       DateTime?         @map("opens_at")
  deadline      DateTime?
  eligibility   String?
  disciplines   String[] // discipline / interest tags used for explainable matching

  // Provenance & governance (Spec §57, §85)
  source     String? // 'manual' | 'import:<source>' — where this listing came from
  sourceUrl  String?          @map("source_url")
  funderId   String?          @map("funder_id")
  institutionId String?       @map("institution_id")
  postedById String?          @map("posted_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  funder      Funder?           @relation(fields: [funderId], references: [id], onDelete: SetNull)
  institution Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  postedBy    User?             @relation("OpportunityPoster", fields: [postedById], references: [id], onDelete: SetNull)
  savedBy     OpportunitySave[]
  notifications Notification[]

  @@index([type])
  @@index([status])
  @@index([deadline])
  @@map("opportunities")
}

/// A researcher bookmarking an opportunity to track it.
model OpportunitySave {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  researcherId  String   @map("researcher_id")
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  researcher  Researcher  @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, researcherId])
  @@index([researcherId])
  @@map("opportunity_saves")
}

// ============================================================
// Researcher Discovery & Profile Claiming (Discovery Engine)
// ============================================================

/// Per-field provenance for a discovered researcher (Discovery Engine §5, §36).
/// Every imported attribute records where it came from and how confident we are.
model ResearcherSource {
  id             String    @id @default(uuid())
  researcherId   String    @map("researcher_id")
  source         String // 'openalex' | 'crossref' | 'orcid' | 'ojs' | ...
  sourceId       String?   @map("source_id")
  sourceUrl      String?   @map("source_url")
  field          String? // which attribute this backs: 'name' | 'institution' | 'orcid' | ...
  confidence     Int? // 0..100
  retrievedAt    DateTime  @default(now()) @map("retrieved_at")
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastVerifiedAt DateTime? @map("last_verified_at")
  payload        Json?

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@index([researcherId])
  @@index([source, sourceId])
  @@map("researcher_sources")
}

/// A secure, single-use claim token for a discovered profile (Discovery Engine
/// §17, §18, §32). The raw token is NEVER stored — only its SHA-256 hash.
model ClaimInvitation {
  id             String                @id @default(uuid())
  researcherId   String                @map("researcher_id")
  tokenHash      String                @unique @map("token_hash")
  channel        ClaimChannel          @default(public)
  status         ClaimInvitationStatus @default(pending)
  referrerUserId String?               @map("referrer_user_id")
  email          String? // only if legitimately obtained + consented
  expiresAt      DateTime              @map("expires_at")
  consumedAt     DateTime?             @map("consumed_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  referrer   User?      @relation("ClaimReferrer", fields: [referrerUserId], references: [id], onDelete: SetNull)

  @@index([researcherId])
  @@index([status])
  @@map("claim_invitations")
}

/// A researcher's per-publication claim/dispute decision (Discovery Engine §14,
/// §15). Disputes remove the association only — never the global scholarly record.
model ResearcherPublicationClaim {
  id            String                 @id @default(uuid())
  researcherId  String                 @map("researcher_id")
  publicationId String                 @map("publication_id")
  status        PublicationClaimStatus @default(review)
  reason        String?
  decidedAt     DateTime?              @map("decided_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  researcher  Researcher  @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([researcherId, publicationId])
  @@index([publicationId])
  @@map("researcher_publication_claims")
}

/// Opt-out / removal record for an unclaimed profile (Discovery Engine §35).
/// Retained minimally so future syncs do not recreate a suppressed profile.
model ProfileSuppression {
  id        String   @id @default(uuid())
  orcid     String?
  nameKey   String   @map("name_key") // normalized name(+country) key
  reason    String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([nameKey])
  @@index([orcid])
  @@map("profile_suppressions")
}

/// A discovery batch run for admin tracking (Discovery Engine §22, §23, §40).
model DiscoveryRun {
  id          String    @id @default(uuid())
  provider    String
  query       String?
  status      String    @default("queued") // queued | running | completed | failed
  discovered  Int       @default(0)
  created     Int       @default(0)
  matched     Int       @default(0)
  startedById String?   @map("started_by_id")
  error       String?
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([provider])
  @@index([status])
  @@map("discovery_runs")
}

/// A research project — the hub that connects outputs, data, funding and people
/// so no output is an isolated PDF (Spec §1, §19).
model Project {
  id               String        @id @default(uuid())
  publicId         String        @unique @map("public_id") // RTJ-00000001
  slug             String        @unique
  title            String
  description      String?
  objectives       String?
  researchQuestions String?      @map("research_questions")
  methodology      String?
  status           ProjectStatus @default(active)
  startDate        DateTime?     @map("start_date")
  endDate          DateTime?     @map("end_date")
  piResearcherId   String?       @map("pi_researcher_id")
  institutionId    String?       @map("institution_id")
  funderId         String?       @map("funder_id")
  grantId          String?       @map("grant_id")
  visibility       VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pi           Researcher?          @relation("ProjectPI", fields: [piResearcherId], references: [id], onDelete: SetNull)
  institution  Institution?         @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  funder       Funder?              @relation(fields: [funderId], references: [id], onDelete: SetNull)
  grant        Grant?               @relation(fields: [grantId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  datasets     Dataset[]
  instruments  Instrument[]
  software     Software[]
  publications ProjectPublication[]

  @@index([status])
  @@index([piResearcherId])
  @@map("projects")
}

model ProjectMember {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  researcherId String   @map("researcher_id")
  role         String?
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([projectId, researcherId])
  @@index([projectId])
  @@map("project_members")
}

model ProjectPublication {
  id            String @id @default(uuid())
  projectId     String @map("project_id")
  publicationId String @map("publication_id")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([projectId, publicationId])
  @@map("project_publications")
}

/// Dataset record (Spec §20). Restricted content is never exposed; the record
/// may be listed but access is gated by accessLevel.
model Dataset {
  id                  String          @id @default(uuid())
  publicId            String          @unique @map("public_id") // RTD-00000001
  slug                String          @unique
  title               String
  description         String?
  creatorResearcherId String?         @map("creator_researcher_id")
  institutionId       String?         @map("institution_id")
  sample              String?
  geography           String?
  methodology         String?
  variablesText       String?            @map("variables_text")
  fileFormats         String?            @map("file_formats")
  accessLevel         DatasetAccessLevel @default(open) @map("access_level")
  licenseCode         String?            @map("license_code")
  doi                 String?
  ethicsInfo          String?         @map("ethics_info")
  version             String?
  releasedOn          DateTime?       @map("released_on")
  citationText        String?         @map("citation_text")
  relatedProjectId    String?         @map("related_project_id")
  visibility          VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  creator     Researcher?  @relation(fields: [creatorResearcherId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  instruments Instrument[]

  @@index([accessLevel])
  @@map("datasets")
}

/// Research instrument / psychometric scale (Spec §21) — strategically
/// important; carries psychometric metadata.
model Instrument {
  id                 String  @id @default(uuid())
  publicId           String  @unique @map("public_id") // RTI-00000001
  slug               String  @unique
  title              String
  construct          String?
  population         String?
  language           String?
  country            String?
  itemCount          Int?    @map("item_count")
  responseScale      String? @map("response_scale")
  scoringMethod      String? @map("scoring_method")
  reliability        String?
  validityEvidence   String? @map("validity_evidence")
  factorStructure    String? @map("factor_structure")
  norms              String?
  translationOf      String? @map("translation_of")
  copyright          String?
  licenseCode        String? @map("license_code")
  doi                String?
  authorResearcherId String? @map("author_researcher_id")
  relatedProjectId   String? @map("related_project_id")
  relatedDatasetId   String? @map("related_dataset_id")
  visibility         VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author  Researcher? @relation(fields: [authorResearcherId], references: [id], onDelete: SetNull)
  project Project?    @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  dataset Dataset?    @relation(fields: [relatedDatasetId], references: [id], onDelete: SetNull)

  @@map("instruments")
}

/// Research software / code (Spec §22).
model Software {
  id                 String  @id @default(uuid())
  publicId           String  @unique @map("public_id") // RTS-00000001
  slug               String  @unique
  name               String
  description        String?
  version            String?
  authorResearcherId String? @map("author_researcher_id")
  repositoryUrl      String? @map("repository_url")
  doi                String?
  licenseCode        String? @map("license_code")
  documentationUrl   String? @map("documentation_url")
  citationText       String? @map("citation_text")
  relatedProjectId   String? @map("related_project_id")
  visibility         VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author  Researcher? @relation(fields: [authorResearcherId], references: [id], onDelete: SetNull)
  project Project?    @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)

  @@map("software")
}

// ============================================================
// OJS integration & sync (Phase 4 — Spec §12)
// ============================================================

/// A connected OJS installation. Version + strategy are DETECTED at runtime and
/// stored here — never hard-coded (Spec §12).
model OjsSource {
  id               String       @id @default(uuid())
  name             String
  baseUrl          String       @map("base_url")
  siteId           String?      @map("site_id")
  versionDetected  String?      @map("version_detected")
  strategy         OjsStrategy?
  oaiUrl           String?      @map("oai_url")
  restApiAvailable Boolean      @default(false) @map("rest_api_available")
  apiTokenEnc      String?      @map("api_token_enc")
  enabled          Boolean      @default(true)
  lastProbedAt     DateTime?    @map("last_probed_at")
  lastSyncedAt     DateTime?    @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journals OjsJournal[]
  articles OjsArticle[]
  authors  OjsAuthor[]
  syncJobs SyncJob[]

  @@unique([baseUrl])
  @@map("ojs_sources")
}

/// Mapping: OJS journal → internal Journal (idempotent, no duplicates — Spec §12).
model OjsJournal {
  id                String  @id @default(uuid())
  ojsSourceId       String  @map("ojs_source_id")
  ojsJournalId      String  @map("ojs_journal_id")
  ojsJournalPath    String? @map("ojs_journal_path")
  internalJournalId String? @map("internal_journal_id")
  title             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source OjsSource @relation(fields: [ojsSourceId], references: [id], onDelete: Cascade)

  @@unique([ojsSourceId, ojsJournalId])
  @@index([ojsSourceId])
  @@map("ojs_journals")
}

/// Mapping: OJS article → internal Publication (idempotent — Spec §12).
model OjsArticle {
  id                    String   @id @default(uuid())
  ojsSourceId           String   @map("ojs_source_id")
  ojsArticleId          String   @map("ojs_article_id")
  ojsJournalId          String?  @map("ojs_journal_id")
  internalPublicationId String?  @map("internal_publication_id")
  doi                   String?
  lastRecordHash        String?  @map("last_record_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source OjsSource @relation(fields: [ojsSourceId], references: [id], onDelete: Cascade)

  @@unique([ojsSourceId, ojsArticleId])
  @@index([ojsSourceId])
  @@map("ojs_articles")
}

/// Mapping: OJS author → internal Researcher (confidence-based; never overwrite
/// verified identity — Spec §12, §58).
model OjsAuthor {
  id                 String  @id @default(uuid())
  ojsSourceId        String  @map("ojs_source_id")
  ojsAuthorKey       String  @map("ojs_author_key")
  internalResearcherId String? @map("internal_researcher_id")
  rawName            String  @map("raw_name")
  orcid              String?

  createdAt DateTime @default(now()) @map("created_at")

  source OjsSource @relation(fields: [ojsSourceId], references: [id], onDelete: Cascade)

  @@unique([ojsSourceId, ojsAuthorKey])
  @@index([ojsSourceId])
  @@map("ojs_authors")
}

/// A sync run (manual/scheduled/webhook) with retry + status (Spec §12, §73).
model SyncJob {
  id          String     @id @default(uuid())
  integration String
  kind        SyncKind   @default(manual)
  status      SyncStatus @default(pending)
  ojsSourceId String?    @map("ojs_source_id")
  scheduledAt DateTime?  @map("scheduled_at")
  startedAt   DateTime?  @map("started_at")
  finishedAt  DateTime?  @map("finished_at")
  processed   Int        @default(0)
  created     Int        @default(0)
  updated     Int        @default(0)
  failed      Int        @default(0)
  error       String?
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  source OjsSource? @relation(fields: [ojsSourceId], references: [id], onDelete: SetNull)
  logs   SyncLog[]

  @@index([status])
  @@index([ojsSourceId])
  @@map("sync_jobs")
}

model SyncLog {
  id        String   @id @default(uuid())
  syncJobId String   @map("sync_job_id")
  level     String   @default("info")
  message   String
  entityRef String?  @map("entity_ref")
  createdAt DateTime @default(now()) @map("created_at")

  job SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@map("sync_logs")
}

// ============================================================
// Provenance & audit (Spec §84, §68)
// ============================================================

/// The provenance spine — one row per external observation of an entity (Spec §84).
model ExternalRecord {
  id                String         @id @default(uuid())
  entityType        String         @map("entity_type")
  entityId          String         @map("entity_id")
  source            ExternalSource
  sourceId          String         @map("source_id")
  sourceUrl         String?        @map("source_url")
  retrievedAt       DateTime       @map("retrieved_at")
  lastSyncedAt      DateTime?      @map("last_synced_at")
  confidence        Float          @default(1)
  rawPayload        Json?          @map("raw_payload")
  normalizedPayload Json?          @map("normalized_payload")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([source, sourceId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([source, sourceId])
  @@map("external_records")
}

/// A normalized master research record built from multiple providers
/// (Federation §16, §18). Providers never overwrite this directly — a
/// conflict-aware resolver chooses each field's value; all source values are
/// retained in WorkFieldProvenance.
model UnifiedWorkRecord {
  id            String  @id @default(uuid())
  publicId      String  @unique @map("public_id") // RTW-00000001
  resourceType  String  @default("publication") @map("resource_type")
  title         String
  subtitle      String?
  abstract      String?
  publishedYear Int?    @map("published_year")
  journalTitle  String? @map("journal_title")
  publisher     String?
  licenseCode   String? @map("license_code")

  // External identifiers — kept per scheme (§16)
  doi        String? @unique
  pmid       String?
  pmcid      String?
  openalexId String? @map("openalex_id")
  dataciteId String? @map("datacite_id")
  crossrefId String? @map("crossref_id")
  ojsId      String? @map("ojs_id")

  /** Optional link to the internal Publication this record corresponds to. */
  publicationId String? @unique @map("publication_id")
  /** 0..1 — confidence in the resolved record (source count + agreement). */
  confidence Float @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  publication     Publication?          @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  fieldProvenance WorkFieldProvenance[]

  @@index([doi])
  @@map("unified_work_records")
}

/// Per-field, per-source value retention for a unified record (Federation §19,
/// §38). Every source's value is stored; the chosen value is flagged
/// `authoritative`, and disagreement is recorded as `conflictStatus`.
model WorkFieldProvenance {
  id             String   @id @default(uuid())
  unifiedWorkId  String   @map("unified_work_id")
  field          String
  source         String
  value          String?
  authoritative  Boolean  @default(false)
  conflictStatus String   @default("none") @map("conflict_status") // none | single | conflict
  retrievedAt    DateTime @default(now()) @map("retrieved_at")

  unifiedWork UnifiedWorkRecord @relation(fields: [unifiedWorkId], references: [id], onDelete: Cascade)

  @@index([unifiedWorkId])
  @@map("work_field_provenance")
}

/// A citation relationship from one work to another, attributed to a source
/// (Federation §30). Counts from different sources stay distinguishable — these
/// edges are stored separately from PublicationCitationCount and never merged.
model CitationEdge {
  id          String   @id @default(uuid())
  citingDoi   String   @map("citing_doi")
  citedDoi    String   @map("cited_doi")
  source      String
  retrievedAt DateTime @default(now()) @map("retrieved_at")

  @@unique([citingDoi, citedDoi, source])
  @@index([citedDoi])
  @@map("citation_edges")
}

/// RVM score snapshot (Spec §23–25). Fully transparent + versioned: stores raw
/// values, normalization, weights, confidence and missing-data so historical
/// scores are reproducible. Weights are PROVISIONAL, pending validation (§24).
model RvmScore {
  id          String   @id @default(uuid())
  subjectType String   @map("subject_type") // 'researcher' | 'institution' | 'group'
  subjectId   String   @map("subject_id")
  version     String
  overall     Float
  dimensions  Json
  confidence  Float
  missingData Json?    @map("missing_data")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@index([subjectType, subjectId, calculatedAt])
  @@map("rvm_scores")
}

// ============================================================
// Collaboration & research groups (Phase 8 — Spec §18, §27)
// ============================================================

model ResearchGroup {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  description      String?
  interests        String?
  institutionId    String?  @map("institution_id")
  leadResearcherId String?  @map("lead_researcher_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  institution Institution?          @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  lead        Researcher?           @relation("GroupLead", fields: [leadResearcherId], references: [id], onDelete: SetNull)
  members     ResearchGroupMember[]

  @@map("research_groups")
}

model ResearchGroupMember {
  id           String   @id @default(uuid())
  groupId      String   @map("group_id")
  researcherId String   @map("researcher_id")
  role         String?
  joinedAt     DateTime @default(now()) @map("joined_at")

  group      ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  researcher Researcher    @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([groupId, researcherId])
  @@index([groupId])
  @@index([researcherId])
  @@map("research_group_members")
}

/// A collaboration request between researchers (Spec §18). Recommendations that
/// prompt these always carry an explanation (Spec §29).
model CollaborationRequest {
  id             String                     @id @default(uuid())
  fromResearcherId String                   @map("from_researcher_id")
  toResearcherId   String                   @map("to_researcher_id")
  message        String?
  status         CollaborationRequestStatus @default(pending)

  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  from Researcher @relation("CollabFrom", fields: [fromResearcherId], references: [id], onDelete: Cascade)
  to   Researcher @relation("CollabTo", fields: [toResearcherId], references: [id], onDelete: Cascade)

  @@unique([fromResearcherId, toResearcherId])
  @@index([toResearcherId, status])
  @@index([fromResearcherId, status])
  @@map("collaboration_requests")
}

// ============================================================
// Analytics (Phase 9 — Spec §41)
// ============================================================

/// Raw interaction event. Bots are recorded but flagged (`isBot`) and excluded
/// from human counts (Spec §41, §65). Only a pseudonymous visitor hash is
/// stored — never a raw IP (Spec §36).
model AnalyticsEvent {
  id           String             @id @default(uuid())
  eventType    AnalyticsEventType @map("event_type")
  entityType   String             @map("entity_type")
  entityId     String             @map("entity_id")
  visitorHash  String?            @map("visitor_hash")
  isBot        Boolean            @default(false) @map("is_bot")
  referrerHost String?            @map("referrer_host")
  country      String?
  occurredAt   DateTime           @default(now()) @map("occurred_at")

  @@index([entityType, entityId, eventType, isBot])
  @@index([occurredAt])
  @@index([entityType, entityId, visitorHash, eventType, occurredAt])
  @@map("analytics_events")
}

/// Periodic aggregated snapshot for trends (Spec §41). Populated by a worker
/// aggregation job; trends can also be derived directly from events for MVP.
model MetricSnapshot {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  period     String // e.g. '2026-08-12' (day) or 'all'
  payload    Json
  capturedAt DateTime @default(now()) @map("captured_at")

  @@unique([entityType, entityId, period])
  @@index([entityType, entityId, capturedAt])
  @@map("metric_snapshots")
}

/// Append-only audit trail — no silent destructive edits (Spec §68).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Engagement notifications (§41): a researcher is told when their work is read,
/// downloaded, or recommended — with a coarse "from where" (country only; never
/// a reader IP), consistent with the privacy policy.
enum NotificationType {
  publication_read
  publication_download
  publication_recommend
  citation
  opportunity_match
  collaboration_request
  follow
  coauthor_added
}

model Notification {
  id            String           @id @default(uuid())
  recipientId   String           @map("recipient_id")
  type          NotificationType
  publicationId String?          @map("publication_id")
  opportunityId String?          @map("opportunity_id")
  actorLabel    String?          @map("actor_label") // e.g. "A reader" or a researcher name
  country       String? // ISO country name/code — coarse "from where"
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  recipient   Researcher   @relation("ResearcherNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// A blog post authored in the admin console (§82). Body is plain paragraphs
/// separated by blank lines; `tone` selects the branded cover gradient.
model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  tone        String    @default("blue")
  coverImage  String?   @map("cover_image")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  authorId    String?   @map("author_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@map("blog_posts")
}

/// One researcher following another (§18). A lightweight social edge — distinct
/// from collaboration requests and from co-authorship.
model Follow {
  id         String   @id @default(uuid())
  followerId String   @map("follower_id")
  followedId String   @map("followed_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower Researcher @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followed Researcher @relation("Followers", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followedId])
  @@map("follows")
}

/// A researcher bookmarking a publication to read/track later (§18).
model PublicationSave {
  id            String   @id @default(uuid())
  researcherId  String   @map("researcher_id")
  publicationId String   @map("publication_id")
  createdAt     DateTime @default(now()) @map("created_at")

  researcher  Researcher  @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([researcherId, publicationId])
  @@index([researcherId])
  @@map("publication_saves")
}

/// Monthly usage counter for metered premium features (e.g. AI generations).
model AssistantUsage {
  id           String @id @default(uuid())
  researcherId String @map("researcher_id")
  period       String // "YYYY-MM"
  count        Int    @default(0)

  @@unique([researcherId, period])
  @@map("assistant_usage")
}
