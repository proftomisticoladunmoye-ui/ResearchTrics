// ResearchTrics — Prisma schema
// Phase 1 (Foundation) scope. Aligned with docs/DATABASE-ARCHITECTURE.md.
// Later phases add: publications, projects, datasets, instruments, software,
// journals, metrics, rvm_*, ojs_*, sync_*, notifications, etc.
//
// Conventions:
// - Primary keys: uuid (v4 default; v7 preferred once pinned to a Prisma version
//   that supports uuid(7) across the toolchain).
// - Provenance on imported records via ExternalRecord (Spec §84).
// - Soft deletion via deletedAt on scholarly-adjacent records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserStatus {
  active
  suspended
  pending
}

enum RoleType {
  researcher
  student_researcher
  research_assistant
  research_group_admin
  institution_admin
  department_admin
  journal_editor
  publisher_admin
  reviewer
  research_administrator
  funder
  employer
  platform_admin
  super_admin
}

enum ScopeType {
  global
  institution
  department
  research_group
  journal
}

enum ResearcherType {
  academic
  independent
  student
  research_assistant
  practitioner
  other
}

enum CareerStage {
  undergraduate
  graduate
  doctoral
  early_career
  mid_career
  senior
  professor
  research_administrator
  independent
}

enum VisibilityLevel {
  public
  researchers
  institution
  private
}

enum IdentifierScheme {
  orcid
  scopus
  wos
  openalex
  scholar_url
  ror
}

enum ExternalSource {
  crossref
  orcid
  openalex
  ojs
  datacite
  user
}

enum AffiliationRole {
  faculty
  postdoc
  phd_student
  masters_student
  research_staff
  visiting
  emeritus
  other
}

/// Research output types (Spec §9) — not limited to journal articles.
enum OutputType {
  journal_article
  conference_paper
  conference_proceeding
  preprint
  postprint
  working_paper
  technical_report
  research_report
  thesis
  dissertation
  book
  book_chapter
  dataset
  instrument
  software
  poster
  presentation
  policy_brief
  research_brief
  systematic_review
  meta_analysis
  registered_report
  other
}

/// Version-of-record lineage (Spec §60).
enum PublicationVersion {
  preprint
  accepted_manuscript
  version_of_record
  correction
  retraction
}

/// Identifier schemes for publications.
enum PublicationIdScheme {
  doi
  pmid
  pmcid
  arxiv
  isbn
  openalex
  handle
}

/// Citation counts are source-labelled and never merged (Spec §33).
enum CitationSource {
  crossref
  openalex
  scholar
  scopus
  wos
}

/// File access levels (Spec §46, §34).
enum FileAccessLevel {
  public
  restricted
  request
  embargoed
  private
}

/// Background sync lifecycle (Spec §12, §73).
enum SyncStatus {
  pending
  running
  completed
  failed
  partial
}

enum SyncKind {
  manual
  scheduled
  webhook
}

/// How an OJS source is harvested (Spec §12). Detected at runtime, never assumed.
enum OjsStrategy {
  oai_pmh
  native_rest
}

/// Collaboration request lifecycle (Spec §18).
enum CollaborationRequestStatus {
  pending
  accepted
  declined
  withdrawn
}

/// Project lifecycle (Spec §19).
enum ProjectStatus {
  proposed
  active
  completed
  suspended
  archived
}

/// Dataset access conditions (Spec §20). Restricted content is never exposed.
enum DatasetAccessLevel {
  open
  restricted
  request
  embargoed
  private
}

/// Analytics event types (Spec §41). Distinguishes the interaction kinds the
/// platform counts; bots are flagged and excluded from human counts.
enum AnalyticsEventType {
  page_view
  publication_view
  profile_view
  project_view
  dataset_view
  instrument_view
  software_view
  journal_view
  institution_view
  download
  citation_export
  search_appearance
  follow
  external_referral
}

/// Kinds of research opportunity that can be curated (Phase 13, Spec §20).
enum OpportunityType {
  grant
  fellowship
  call_for_papers
  conference
  position
  award
  training
  collaboration
  other
}

enum OpportunityStatus {
  draft
  open
  closed
  archived
}

// ============================================================
// Identity & accounts
// ============================================================

/// Auth principal only — NOT the scholarly identity (Spec §7).
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(pending)
  emailVerified Boolean   @default(false) @map("email_verified")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  mfaSecret    String?    @map("mfa_secret")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions           Session[]
  roles              UserRole[]
  opportunitiesPosted Opportunity[] @relation("OpportunityPoster")
  researcher         Researcher?
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]

  @@index([status])
  @@map("users")
}

/// Server-side sessions with rotation support (Spec §35).
model Session {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  rotatedFrom String?  @map("rotated_from")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// RBAC role assignment, scoped to a context (Spec §6, §49).
model UserRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  role      RoleType
  scopeType ScopeType @default(global) @map("scope_type")
  scopeId   String?   @map("scope_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@index([userId])
  @@map("user_roles")
}

/// Core scholarly identity — persistent RTX ID (Spec §7).
model Researcher {
  id              String  @id @default(uuid())
  researchtricsId String  @unique @map("researchtrics_id") // RTX-00000001
  userId          String? @unique @map("user_id")

  givenNames    String?  @map("given_names")
  familyName    String?  @map("family_name")
  preferredName String?  @map("preferred_name")
  displayName   String   @map("display_name")
  slug          String   @unique
  biography     String?
  country       String?
  city          String?
  academicRank  String?  @map("academic_rank")
  website       String?
  photoUrl      String?  @map("photo_url")

  researcherType     ResearcherType  @default(academic) @map("researcher_type")
  careerStage        CareerStage?    @map("career_stage")
  verificationLevel  Int             @default(0) @map("verification_level")
  profileVisibility  VisibilityLevel @default(public) @map("profile_visibility")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  identifiers         ResearcherIdentifier[]
  nameVariants        ResearcherNameVariant[]
  affiliations        Affiliation[]
  interests           ResearchInterest[]
  verificationRecords VerificationRecord[]
  orcidConnection     OrcidConnection?
  authorships         PublicationAuthor[]
  projectsLed         Project[]           @relation("ProjectPI")
  projectMemberships  ProjectMember[]
  datasetsCreated     Dataset[]
  instrumentsAuthored Instrument[]
  softwareAuthored    Software[]
  groupsLed           ResearchGroup[]     @relation("GroupLead")
  groupMemberships    ResearchGroupMember[]
  sentCollabRequests     CollaborationRequest[] @relation("CollabFrom")
  receivedCollabRequests CollaborationRequest[] @relation("CollabTo")
  opportunitySaves       OpportunitySave[]

  @@index([familyName])
  @@index([verificationLevel])
  @@map("researchers")
}

/// External scholarly identifiers as mappings — internal RTX stays authoritative (Spec §7, §85).
model ResearcherIdentifier {
  id           String           @id @default(uuid())
  researcherId String           @map("researcher_id")
  scheme       IdentifierScheme
  value        String
  verified     Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([scheme, value])
  @@index([researcherId])
  @@map("researcher_identifiers")
}

/// Name variants for disambiguation — never auto-merge on name alone (Spec §7, §58).
model ResearcherNameVariant {
  id           String  @id @default(uuid())
  researcherId String  @map("researcher_id")
  name         String
  script       String?
  source       String?

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@index([researcherId])
  @@map("researcher_name_variants")
}

// ============================================================
// Organizations
// ============================================================

model Institution {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  rorId     String? @unique @map("ror_id")
  country   String?
  city      String?
  type      String?
  isTenant  Boolean @default(false) @map("is_tenant")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  departments    Department[]
  affiliations   Affiliation[]
  projects       Project[]
  datasets       Dataset[]
  researchGroups ResearchGroup[]
  opportunities  Opportunity[]

  @@index([country])
  @@map("institutions")
}

model Department {
  id                 String  @id @default(uuid())
  institutionId      String  @map("institution_id")
  name               String
  parentDepartmentId String? @map("parent_department_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  children         Department[] @relation("DepartmentHierarchy")
  affiliations     Affiliation[]

  @@index([institutionId])
  @@map("departments")
}

/// Time-bounded M:N — verified affiliations never overwritten blindly (Spec §85).
model Affiliation {
  id            String          @id @default(uuid())
  researcherId  String          @map("researcher_id")
  institutionId String          @map("institution_id")
  departmentId  String?         @map("department_id")
  role          AffiliationRole @default(faculty)
  startDate     DateTime?       @map("start_date")
  endDate       DateTime?       @map("end_date")
  isPrimary     Boolean         @default(false) @map("is_primary")
  verified      Boolean         @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  researcher  Researcher  @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([researcherId])
  @@index([institutionId])
  @@map("affiliations")
}

// ============================================================
// Identity: interests, verification, ORCID (Phase 2 — Spec §7, §13, §38)
// ============================================================

/// Free-text research interests (Spec §7, §8).
model ResearchInterest {
  id           String   @id @default(uuid())
  researcherId String   @map("researcher_id")
  label        String
  createdAt    DateTime @default(now()) @map("created_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([researcherId, label])
  @@index([researcherId])
  @@map("research_interests")
}

/// Auditable verification history (Spec §38). Levels 0..5; honestly labelled.
model VerificationRecord {
  id           String   @id @default(uuid())
  researcherId String   @map("researcher_id")
  level        Int
  method       String
  evidenceRef  String?  @map("evidence_ref")
  verifiedById String?  @map("verified_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@index([researcherId])
  @@map("verification_records")
}

/// ORCID OAuth connection. Tokens are ENCRYPTED at rest and never exposed to
/// the frontend (Spec §13, §35).
model OrcidConnection {
  id                String    @id @default(uuid())
  researcherId      String    @unique @map("researcher_id")
  orcid             String    @unique
  accessTokenEnc    String    @map("access_token_enc")
  refreshTokenEnc   String?   @map("refresh_token_enc")
  scope             String?
  tokenExpiresAt    DateTime? @map("token_expires_at")
  connectedAt       DateTime  @default(now()) @map("connected_at")
  lastSyncedAt      DateTime? @map("last_synced_at")

  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@map("orcid_connections")
}

/// Single-use tokens for email verification / password reset (Spec §38, §40).
/// Only the hash of the token is stored.
model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  purpose   String
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ============================================================
// Publications & outputs (Phase 3 — Spec §9, §10, §33, §60)
// ============================================================

model Journal {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  issnPrint      String? @map("issn_print")
  issnElectronic String? @map("issn_electronic")
  publisher      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  publications Publication[]

  @@index([name])
  @@map("journals")
}

/// A scholarly publication — a first-class graph node, never an isolated PDF (Spec §1, §10).
model Publication {
  id          String             @id @default(uuid())
  publicId    String             @unique @map("public_id") // RTP-00000001
  slug        String             @unique
  title       String
  abstract    String?
  outputType  OutputType         @default(journal_article) @map("output_type")
  versionType PublicationVersion @default(version_of_record) @map("version_type")

  journalId   String?  @map("journal_id")
  volume      String?
  issue       String?
  firstPage   String?  @map("first_page")
  lastPage    String?  @map("last_page")
  publishedOn DateTime? @map("published_on")
  publishedYear Int?    @map("published_year")
  publisher   String?
  articleType String?  @map("article_type")

  licenseCode String?  @map("license_code")
  openAccess  Boolean  @default(false) @map("open_access")
  pdfUrl      String?  @map("pdf_url")
  primaryFileId String? @unique @map("primary_file_id")

  visibility VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  journal        Journal?                  @relation(fields: [journalId], references: [id], onDelete: SetNull)
  primaryFile    File?                     @relation("PrimaryFile", fields: [primaryFileId], references: [id], onDelete: SetNull)
  identifiers    PublicationIdentifier[]
  authors        PublicationAuthor[]
  citationCounts PublicationCitationCount[]
  projectLinks   ProjectPublication[]

  @@index([publishedYear])
  @@index([journalId])
  @@map("publications")
}

model PublicationIdentifier {
  id            String              @id @default(uuid())
  publicationId String              @map("publication_id")
  scheme        PublicationIdScheme
  value         String
  createdAt     DateTime            @default(now()) @map("created_at")

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([scheme, value])
  @@index([publicationId])
  @@map("publication_identifiers")
}

/// Ordered authorship. Researcher link is nullable + confidence-scored; every
/// author renders even when unmatched (Spec §58).
model PublicationAuthor {
  id              String  @id @default(uuid())
  publicationId   String  @map("publication_id")
  researcherId    String? @map("researcher_id")
  authorOrder     Int     @map("author_order")
  rawName         String  @map("raw_name")
  givenName       String? @map("given_name")
  familyName      String? @map("family_name")
  affiliationText String? @map("affiliation_text")
  orcid           String?
  isCorresponding Boolean @default(false) @map("is_corresponding")
  matchConfidence Float?  @map("match_confidence")

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  researcher  Researcher? @relation(fields: [researcherId], references: [id], onDelete: SetNull)

  @@unique([publicationId, authorOrder])
  @@index([publicationId])
  @@index([researcherId])
  @@map("publication_authors")
}

/// Source-labelled citation counts — never merged across providers (Spec §33).
model PublicationCitationCount {
  id            String         @id @default(uuid())
  publicationId String         @map("publication_id")
  source        CitationSource
  count         Int            @default(0)
  asOf          DateTime       @default(now()) @map("as_of")

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, source])
  @@index([publicationId])
  @@map("publication_citation_counts")
}

/// Object-storage file reference — never store blobs in Postgres (Spec §46).
model File {
  id            String          @id @default(uuid())
  storageKey    String          @unique @map("storage_key")
  filename      String
  mimeType      String          @map("mime_type")
  sizeBytes     Int             @map("size_bytes")
  checksumSha256 String         @map("checksum_sha256")
  accessLevel   FileAccessLevel @default(public) @map("access_level")
  licenseCode   String?         @map("license_code")
  pdfHasText    Boolean?        @map("pdf_has_text")
  uploaderId    String?         @map("uploader_id")

  createdAt DateTime @default(now()) @map("created_at")

  primaryForPublication Publication? @relation("PrimaryFile")

  @@index([uploaderId])
  @@map("files")
}

// ============================================================
// Projects, grants & research outputs (Phase 6 — Spec §19–22)
// ============================================================

model Funder {
  id        String  @id @default(uuid())
  name      String
  rorId     String? @map("ror_id")
  country   String?
  funderDoi String? @map("funder_doi")

  createdAt DateTime @default(now()) @map("created_at")

  grants   Grant[]
  projects Project[]
  opportunities Opportunity[]

  @@map("funders")
}

model Grant {
  id        String    @id @default(uuid())
  title     String
  funderId  String?   @map("funder_id")
  amount    Decimal?  @db.Decimal(14, 2)
  currency  String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")

  funder   Funder?   @relation(fields: [funderId], references: [id], onDelete: SetNull)
  projects Project[]

  @@index([funderId])
  @@map("grants")
}

/// A forward-looking research opportunity researchers can discover — grants,
/// fellowships, calls, positions (Phase 13, Spec §20). Every listing carries
/// provenance (`source`, `sourceUrl`, `postedBy`); nothing is fabricated.
model Opportunity {
  id            String            @id @default(uuid())
  publicId      String            @unique @map("public_id") // RTO-00000001
  slug          String            @unique
  title         String
  type          OpportunityType   @default(grant)
  status        OpportunityStatus @default(open)
  summary       String?
  description   String?
  organization  String? // posting body, free text
  country       String?
  url           String? // canonical external link to apply / read more
  amountMin     Decimal?          @db.Decimal(14, 2) @map("amount_min")
  amountMax     Decimal?          @db.Decimal(14, 2) @map("amount_max")
  currency      String?
  opensAt       DateTime?         @map("opens_at")
  deadline      DateTime?
  eligibility   String?
  disciplines   String[] // discipline / interest tags used for explainable matching

  // Provenance & governance (Spec §57, §85)
  source     String? // 'manual' | 'import:<source>' — where this listing came from
  sourceUrl  String?          @map("source_url")
  funderId   String?          @map("funder_id")
  institutionId String?       @map("institution_id")
  postedById String?          @map("posted_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  funder      Funder?           @relation(fields: [funderId], references: [id], onDelete: SetNull)
  institution Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  postedBy    User?             @relation("OpportunityPoster", fields: [postedById], references: [id], onDelete: SetNull)
  savedBy     OpportunitySave[]

  @@index([type])
  @@index([status])
  @@index([deadline])
  @@map("opportunities")
}

/// A researcher bookmarking an opportunity to track it.
model OpportunitySave {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  researcherId  String   @map("researcher_id")
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  researcher  Researcher  @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, researcherId])
  @@index([researcherId])
  @@map("opportunity_saves")
}

/// A research project — the hub that connects outputs, data, funding and people
/// so no output is an isolated PDF (Spec §1, §19).
model Project {
  id               String        @id @default(uuid())
  publicId         String        @unique @map("public_id") // RTJ-00000001
  slug             String        @unique
  title            String
  description      String?
  objectives       String?
  researchQuestions String?      @map("research_questions")
  methodology      String?
  status           ProjectStatus @default(active)
  startDate        DateTime?     @map("start_date")
  endDate          DateTime?     @map("end_date")
  piResearcherId   String?       @map("pi_researcher_id")
  institutionId    String?       @map("institution_id")
  funderId         String?       @map("funder_id")
  grantId          String?       @map("grant_id")
  visibility       VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pi           Researcher?          @relation("ProjectPI", fields: [piResearcherId], references: [id], onDelete: SetNull)
  institution  Institution?         @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  funder       Funder?              @relation(fields: [funderId], references: [id], onDelete: SetNull)
  grant        Grant?               @relation(fields: [grantId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  datasets     Dataset[]
  instruments  Instrument[]
  software     Software[]
  publications ProjectPublication[]

  @@index([status])
  @@index([piResearcherId])
  @@map("projects")
}

model ProjectMember {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  researcherId String   @map("researcher_id")
  role         String?
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researcher Researcher @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([projectId, researcherId])
  @@index([projectId])
  @@map("project_members")
}

model ProjectPublication {
  id            String @id @default(uuid())
  projectId     String @map("project_id")
  publicationId String @map("publication_id")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([projectId, publicationId])
  @@map("project_publications")
}

/// Dataset record (Spec §20). Restricted content is never exposed; the record
/// may be listed but access is gated by accessLevel.
model Dataset {
  id                  String          @id @default(uuid())
  publicId            String          @unique @map("public_id") // RTD-00000001
  slug                String          @unique
  title               String
  description         String?
  creatorResearcherId String?         @map("creator_researcher_id")
  institutionId       String?         @map("institution_id")
  sample              String?
  geography           String?
  methodology         String?
  variablesText       String?            @map("variables_text")
  fileFormats         String?            @map("file_formats")
  accessLevel         DatasetAccessLevel @default(open) @map("access_level")
  licenseCode         String?            @map("license_code")
  doi                 String?
  ethicsInfo          String?         @map("ethics_info")
  version             String?
  releasedOn          DateTime?       @map("released_on")
  citationText        String?         @map("citation_text")
  relatedProjectId    String?         @map("related_project_id")
  visibility          VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  creator     Researcher?  @relation(fields: [creatorResearcherId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  instruments Instrument[]

  @@index([accessLevel])
  @@map("datasets")
}

/// Research instrument / psychometric scale (Spec §21) — strategically
/// important; carries psychometric metadata.
model Instrument {
  id                 String  @id @default(uuid())
  publicId           String  @unique @map("public_id") // RTI-00000001
  slug               String  @unique
  title              String
  construct          String?
  population         String?
  language           String?
  country            String?
  itemCount          Int?    @map("item_count")
  responseScale      String? @map("response_scale")
  scoringMethod      String? @map("scoring_method")
  reliability        String?
  validityEvidence   String? @map("validity_evidence")
  factorStructure    String? @map("factor_structure")
  norms              String?
  translationOf      String? @map("translation_of")
  copyright          String?
  licenseCode        String? @map("license_code")
  doi                String?
  authorResearcherId String? @map("author_researcher_id")
  relatedProjectId   String? @map("related_project_id")
  relatedDatasetId   String? @map("related_dataset_id")
  visibility         VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author  Researcher? @relation(fields: [authorResearcherId], references: [id], onDelete: SetNull)
  project Project?    @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  dataset Dataset?    @relation(fields: [relatedDatasetId], references: [id], onDelete: SetNull)

  @@map("instruments")
}

/// Research software / code (Spec §22).
model Software {
  id                 String  @id @default(uuid())
  publicId           String  @unique @map("public_id") // RTS-00000001
  slug               String  @unique
  name               String
  description        String?
  version            String?
  authorResearcherId String? @map("author_researcher_id")
  repositoryUrl      String? @map("repository_url")
  doi                String?
  licenseCode        String? @map("license_code")
  documentationUrl   String? @map("documentation_url")
  citationText       String? @map("citation_text")
  relatedProjectId   String? @map("related_project_id")
  visibility         VisibilityLevel @default(public)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author  Researcher? @relation(fields: [authorResearcherId], references: [id], onDelete: SetNull)
  project Project?    @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)

  @@map("software")
}

// ============================================================
// OJS integration & sync (Phase 4 — Spec §12)
// ============================================================

/// A connected OJS installation. Version + strategy are DETECTED at runtime and
/// stored here — never hard-coded (Spec §12).
model OjsSource {
  id               String       @id @default(uuid())
  name             String
  baseUrl          String       @map("base_url")
  siteId           String?      @map("site_id")
  versionDetected  String?      @map("version_detected")
  strategy         OjsStrategy?
  oaiUrl           String?      @map("oai_url")
  restApiAvailable Boolean      @default(false) @map("rest_api_available")
  apiTokenEnc      String?      @map("api_token_enc")
  enabled          Boolean      @default(true)
  lastProbedAt     DateTime?    @map("last_probed_at")
  lastSyncedAt     DateTime?    @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journals OjsJournal[]
  articles OjsArticle[]
  authors  OjsAuthor[]
  syncJobs SyncJob[]

  @@unique([baseUrl])
  @@map("ojs_sources")
}

/// Mapping: OJS journal → internal Journal (idempotent, no duplicates — Spec §12).
model OjsJournal {
  id                String  @id @default(uuid())
  ojsSourceId       String  @map("ojs_source_id")
  ojsJournalId      String  @map("ojs_journal_id")
  ojsJournalPath    String? @map("ojs_journal_path")
  internalJournalId String? @map("internal_journal_id")
  title             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source OjsSource @relation(fields: [ojsSourceId], references: [id], onDelete: Cascade)

  @@unique([ojsSourceId, ojsJournalId])
  @@index([ojsSourceId])
  @@map("ojs_journals")
}

/// Mapping: OJS article → internal Publication (idempotent — Spec §12).
model OjsArticle {
  id                    String   @id @default(uuid())
  ojsSourceId           String   @map("ojs_source_id")
  ojsArticleId          String   @map("ojs_article_id")
  ojsJournalId          String?  @map("ojs_journal_id")
  internalPublicationId String?  @map("internal_publication_id")
  doi                   String?
  lastRecordHash        String?  @map("last_record_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source OjsSource @relation(fields: [ojsSourceId], references: [id], onDelete: Cascade)

  @@unique([ojsSourceId, ojsArticleId])
  @@index([ojsSourceId])
  @@map("ojs_articles")
}

/// Mapping: OJS author → internal Researcher (confidence-based; never overwrite
/// verified identity — Spec §12, §58).
model OjsAuthor {
  id                 String  @id @default(uuid())
  ojsSourceId        String  @map("ojs_source_id")
  ojsAuthorKey       String  @map("ojs_author_key")
  internalResearcherId String? @map("internal_researcher_id")
  rawName            String  @map("raw_name")
  orcid              String?

  createdAt DateTime @default(now()) @map("created_at")

  source OjsSource @relation(fields: [ojsSourceId], references: [id], onDelete: Cascade)

  @@unique([ojsSourceId, ojsAuthorKey])
  @@index([ojsSourceId])
  @@map("ojs_authors")
}

/// A sync run (manual/scheduled/webhook) with retry + status (Spec §12, §73).
model SyncJob {
  id          String     @id @default(uuid())
  integration String
  kind        SyncKind   @default(manual)
  status      SyncStatus @default(pending)
  ojsSourceId String?    @map("ojs_source_id")
  scheduledAt DateTime?  @map("scheduled_at")
  startedAt   DateTime?  @map("started_at")
  finishedAt  DateTime?  @map("finished_at")
  processed   Int        @default(0)
  created     Int        @default(0)
  updated     Int        @default(0)
  failed      Int        @default(0)
  error       String?
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  source OjsSource? @relation(fields: [ojsSourceId], references: [id], onDelete: SetNull)
  logs   SyncLog[]

  @@index([status])
  @@index([ojsSourceId])
  @@map("sync_jobs")
}

model SyncLog {
  id        String   @id @default(uuid())
  syncJobId String   @map("sync_job_id")
  level     String   @default("info")
  message   String
  entityRef String?  @map("entity_ref")
  createdAt DateTime @default(now()) @map("created_at")

  job SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@map("sync_logs")
}

// ============================================================
// Provenance & audit (Spec §84, §68)
// ============================================================

/// The provenance spine — one row per external observation of an entity (Spec §84).
model ExternalRecord {
  id                String         @id @default(uuid())
  entityType        String         @map("entity_type")
  entityId          String         @map("entity_id")
  source            ExternalSource
  sourceId          String         @map("source_id")
  sourceUrl         String?        @map("source_url")
  retrievedAt       DateTime       @map("retrieved_at")
  lastSyncedAt      DateTime?      @map("last_synced_at")
  confidence        Float          @default(1)
  rawPayload        Json?          @map("raw_payload")
  normalizedPayload Json?          @map("normalized_payload")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([source, sourceId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([source, sourceId])
  @@map("external_records")
}

/// RVM score snapshot (Spec §23–25). Fully transparent + versioned: stores raw
/// values, normalization, weights, confidence and missing-data so historical
/// scores are reproducible. Weights are PROVISIONAL, pending validation (§24).
model RvmScore {
  id          String   @id @default(uuid())
  subjectType String   @map("subject_type") // 'researcher' | 'institution' | 'group'
  subjectId   String   @map("subject_id")
  version     String
  overall     Float
  dimensions  Json
  confidence  Float
  missingData Json?    @map("missing_data")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@index([subjectType, subjectId, calculatedAt])
  @@map("rvm_scores")
}

// ============================================================
// Collaboration & research groups (Phase 8 — Spec §18, §27)
// ============================================================

model ResearchGroup {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  description      String?
  interests        String?
  institutionId    String?  @map("institution_id")
  leadResearcherId String?  @map("lead_researcher_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  institution Institution?          @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  lead        Researcher?           @relation("GroupLead", fields: [leadResearcherId], references: [id], onDelete: SetNull)
  members     ResearchGroupMember[]

  @@map("research_groups")
}

model ResearchGroupMember {
  id           String   @id @default(uuid())
  groupId      String   @map("group_id")
  researcherId String   @map("researcher_id")
  role         String?
  joinedAt     DateTime @default(now()) @map("joined_at")

  group      ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  researcher Researcher    @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([groupId, researcherId])
  @@index([groupId])
  @@index([researcherId])
  @@map("research_group_members")
}

/// A collaboration request between researchers (Spec §18). Recommendations that
/// prompt these always carry an explanation (Spec §29).
model CollaborationRequest {
  id             String                     @id @default(uuid())
  fromResearcherId String                   @map("from_researcher_id")
  toResearcherId   String                   @map("to_researcher_id")
  message        String?
  status         CollaborationRequestStatus @default(pending)

  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  from Researcher @relation("CollabFrom", fields: [fromResearcherId], references: [id], onDelete: Cascade)
  to   Researcher @relation("CollabTo", fields: [toResearcherId], references: [id], onDelete: Cascade)

  @@unique([fromResearcherId, toResearcherId])
  @@index([toResearcherId, status])
  @@index([fromResearcherId, status])
  @@map("collaboration_requests")
}

// ============================================================
// Analytics (Phase 9 — Spec §41)
// ============================================================

/// Raw interaction event. Bots are recorded but flagged (`isBot`) and excluded
/// from human counts (Spec §41, §65). Only a pseudonymous visitor hash is
/// stored — never a raw IP (Spec §36).
model AnalyticsEvent {
  id           String             @id @default(uuid())
  eventType    AnalyticsEventType @map("event_type")
  entityType   String             @map("entity_type")
  entityId     String             @map("entity_id")
  visitorHash  String?            @map("visitor_hash")
  isBot        Boolean            @default(false) @map("is_bot")
  referrerHost String?            @map("referrer_host")
  country      String?
  occurredAt   DateTime           @default(now()) @map("occurred_at")

  @@index([entityType, entityId, eventType, isBot])
  @@index([occurredAt])
  @@index([entityType, entityId, visitorHash, eventType, occurredAt])
  @@map("analytics_events")
}

/// Periodic aggregated snapshot for trends (Spec §41). Populated by a worker
/// aggregation job; trends can also be derived directly from events for MVP.
model MetricSnapshot {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  period     String // e.g. '2026-08-12' (day) or 'all'
  payload    Json
  capturedAt DateTime @default(now()) @map("captured_at")

  @@unique([entityType, entityId, period])
  @@index([entityType, entityId, capturedAt])
  @@map("metric_snapshots")
}

/// Append-only audit trail — no silent destructive edits (Spec §68).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
