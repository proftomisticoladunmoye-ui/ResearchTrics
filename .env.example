# ============================================================
# ResearchTrics — Environment Configuration (EXAMPLE)
# Copy to .env and fill in. NEVER commit real secrets (Spec §35, §95).
# ============================================================

# ---- Core ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://researchtrics:researchtrics@localhost:5432/researchtrics?schema=public
# Direct (non-pooled) connection for migrations, if using a pooler in prod
DIRECT_URL=postgresql://researchtrics:researchtrics@localhost:5432/researchtrics?schema=public

# ---- Redis (cache + BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Security ----
# 32+ char random string. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# 32-byte key (base64) for encrypting OAuth tokens at rest. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me-base64-32-bytes-key

# ---- Object storage (S3-compatible / MinIO) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=researchtrics
OBJECT_STORAGE_KEY=minioadmin
OBJECT_STORAGE_SECRET=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ---- Integrations (Phase 2+; not required for Phase 1) ----
# ORCID
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/api/v1/integrations/orcid/callback
ORCID_ENVIRONMENT=sandbox
# Crossref (polite pool contact)
CROSSREF_MAILTO=
# OpenAlex (polite pool contact)
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# OJS (fresh install provisioned in docker-compose)
OJS_BASE_URL=http://localhost:8081
OJS_SITE_ID=
OJS_API_KEY=

# ---- AI provider (Phase 11; abstraction default = Claude) ----
AI_PROVIDER=claude
AI_API_KEY=

# ---- Email (Phase 2+) ----
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@researchtrics.local
